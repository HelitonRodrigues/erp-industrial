{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/tv",
      "destination": "/painel-metas.html"
    },
    {
      "source": "/R/:cod",
      "destination": "/rastreio.html"
    },
    {
      "source": "/r/:cod",
      "destination": "/rastreio.html"
    }
  ]
}