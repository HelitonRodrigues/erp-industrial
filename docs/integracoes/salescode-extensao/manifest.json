{
  "manifest_version": 3,
  "name": "Silicate — Atualizar ERP (Salescode)",
  "version": "1.1.0",
  "description": "Lê os Pedidos Disponíveis do Salescode e atualiza a Programação de Cargas do ERP Silicate.",
  "action": { "default_title": "Atualizar ERP com o Salescode", "default_icon": { "48": "icone48.png", "128": "icone128.png" } },
  "icons": { "48": "icone48.png", "128": "icone128.png" },
  "background": { "service_worker": "fundo.js" },
  "content_scripts": [{
    "matches": ["https://salescode.com.br/adm/producao/pedidosDisponiveis*"],
    "js": ["coletor.js"],
    "run_at": "document_idle"
  }],
  "host_permissions": ["https://salescode.com.br/*", "https://zodgbitbflkepbszshmu.supabase.co/*"]
}
